# Copy to /etc/key-writer/key-writer.env, chmod 0640, owner root:key-writer.
APP_ENVIRONMENT=production
TRUSTED_HOSTS=crm3.dtel.ru,localhost,127.0.0.1

DATABASE_URL=postgresql+psycopg://key_writer:CHANGE_ME@127.0.0.1:5432/key_writer
DATABASE_ECHO=false
DATABASE_CONNECT_TIMEOUT=5
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

SESSION_SECRET=CHANGE_TO_OPENSSL_RAND_HEX_32
SESSION_HTTPS_ONLY=true
SESSION_MAX_AGE_SECONDS=28800

CRM_BASE_URL=https://crm.dtel.ru
CRM_COOKIE=
CRM_LOGIN=
CRM_PASSWORD=
CRM_BUYER_ID=
REQUEST_TIMEOUT=20

# Keep true for initial deployment. Disable only after controlled validation.
DRY_RUN=true
PANEL_API_LOGIN=
PANEL_API_PASSWORD=
PANEL_API_TIMEOUT=3

PANEL_MONITOR_ENABLED=true
PANEL_MONITOR_INTERVAL_SECONDS=300
PANEL_MONITOR_CONCURRENCY=12
PANEL_MONITOR_STALE_SECONDS=600
PANEL_MANUAL_CHECK_COOLDOWN_SECONDS=10

BACKUP_DIR=/var/backups/key-writer
BACKUP_RETENTION_DAYS=21
BACKUP_PG_SERVICE=key_writer
PGSERVICEFILE=/etc/key-writer/pg_service.conf
PGPASSFILE=/etc/key-writer/pgpass
