POSTGRES_DB=dtel
POSTGRES_USER=dtel
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://dtel:change-me@127.0.0.1:5432/dtel
# Used only by pytest. It must be a separate database and its name must
# explicitly contain "test", for example dtel_test.
TEST_DATABASE_URL=postgresql+psycopg://dtel:change-me@127.0.0.1:5432/dtel_test
DATABASE_ECHO=false
DATABASE_CONNECT_TIMEOUT=5

CRM_BASE_URL=https://crm.dtel.ru
CRM_COOKIE=
CRM_LOGIN=
CRM_PASSWORD=
CRM_BUYER_ID=
DRY_RUN=false
REQUEST_TIMEOUT=20

PANEL_API_LOGIN=
PANEL_API_PASSWORD=
PANEL_API_TIMEOUT=3

# These five values are startup defaults only. After an administrator saves
# monitoring settings in the UI, PostgreSQL system_settings takes precedence
# and all workers read the same values before the next monitoring cycle.
PANEL_MONITOR_ENABLED=true
PANEL_MONITOR_INTERVAL_SECONDS=300
PANEL_MONITOR_CONCURRENCY=12
PANEL_MONITOR_STALE_SECONDS=600
PANEL_MANUAL_CHECK_COOLDOWN_SECONDS=10

SESSION_SECRET=replace-with-a-long-random-secret
SESSION_HTTPS_ONLY=false
